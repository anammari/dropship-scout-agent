# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc

# Secrets — never commit runtime credentials
.env
# .env.example IS tracked on purpose: it holds placeholders and documents
# every key. Real values live only in .env / the process environment.

# Saved AliExpress login for the Dropshipping Center gate (session cookies;
# written by scripts/generate_ali_session.py)
ali_ds_state.json

# Scratch session notes — operating context lives in CLAUDE.md, so this file
# is never tracked even if recreated locally.
SESSION_CONTEXT.md

# Agent plan prompts — working directives, not deliverables. They live on the
# operator's machine only (and in the session they came from), so no plan
# prompt is ever tracked, here or in any future checkout. The Step 2 product
# list lives here too: it is scoping input for the keyword-generation LLM, not
# a repo artefact.
plans/

# Third-party reference kept for a later phase: the TypeSafe (Jev) API doc.
# The Jev gate is wired through OpenRouter for now, so this stays a local
# future reference rather than a tracked file.
docs/TypeSafe_agent_skill_doc.md

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Logs
*.log

# OS noise
.DS_Store
