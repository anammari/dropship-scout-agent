# ---------------------------------------------------------------------------
# Dropship Scout Agent — runtime configuration template.
# Copy to `.env` and fill in the values you use. Every key here is read by
# src/config.py (Settings); real environment variables always win over .env.
# Full reference: _docs/plan.md §10.
# ---------------------------------------------------------------------------

# --- Supplier extractors (tried in SUPPLIER_PRIORITY_ORDER) ---

# CJdropshipping MCP token (primary engine, src/extractors/cj_mcp_extractor.py).
# Generate it on CJ's API Authorization page; the client appends it to the
# remote MCP endpoint as a path segment (never logged).
CJ_MCP_TOKEN="YOUR_COPIED_MCP_TOKEN"
# Remote MCP endpoint WITHOUT the token (the token is appended at connect time)
#CJ_MCP_BASE_URL="https://developers.cjdropshipping.com/mcp"

# Apify token for the managed AliExpress scraper (src/extractors/aliexpress_apify.py)
APIFY_API_TOKEN=your_api_token_here
# Actor to run (apify-client actor id). Pinned to a PAY-PER-RESULT actor:
# the free-tier monthly credit covers per-result charges but cannot pay an
# actor's flat monthly rental. Set the Apify Console monthly spend limit to
# $5 so the platform enforces the budget.
#APIFY_ACTOR_ID="cryptosignals/aliexpress-scraper"
# Listings fetched per keyword run, and the Apify call wait bound (seconds)
#APIFY_MAX_ITEMS="20"
#APIFY_RUN_TIMEOUT_SECS="60"
# Budget guard: per-result price (for the run cost estimate) and the hard
# per-run item cap (worst-case spend = APIFY_MAX_ITEMS_PER_RUN x price)
#APIFY_PRICE_PER_RESULT_USD="0.005"
#APIFY_MAX_ITEMS_PER_RUN="100"

# Etsy Open API v3 key (src/extractors/etsy_api.py)
ETSY_API_KEY=""

# --- Extractor chain & pricing ---

# Comma-separated supplier keys for auto mode (default: cjdropshipping,aliexpress,etsy)
#SUPPLIER_PRIORITY_ORDER="cjdropshipping,aliexpress,etsy"
# Supplier list prices are USD; extractors convert to AUD with this rate
#USD_TO_AUD="1.55"
# Max CJ products expanded (product-detail fetch + gallery) per keyword
#CJ_MAX_PRODUCTS="10"

# Target country for supplier discovery: the AliExpress actor's shipping
# destination, and the CJ liveness gate's preferred stock country (CJ's own
# warehouse filter is pinned to CN)
#TARGET_COUNTRY="AU"

# --- LLM evaluation (Ollama Cloud, OpenAI-compatible) ---
LLM_BASE_URL="https://ollama.com/v1"
LLM_API_KEY="your_ollama_cloud_api_token"
LLM_MODEL="deepseek-v4-flash:cloud"

# --- Export destination (Shopify workspace) ---
#EXPORT_DIR="/Users/ahmadammari/PD/my-store-build/inspiration/dropship-candidates"

# --- Misc ---
# Desktop UA used by CDN downloads and the Apify PDP gallery harvest
# (default: a desktop Chrome UA)
#USER_AGENT=""