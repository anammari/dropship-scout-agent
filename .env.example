# ---------------------------------------------------------------------------
# Dropship Scout Agent — runtime configuration template.
# Copy to `.env` and fill in the values you use. Every key here is read by
# src/config.py (Settings); real environment variables always win over .env.
# Full reference: _docs/plan.md §10.
# ---------------------------------------------------------------------------

# --- Supplier extractors (tried in SUPPLIER_PRIORITY_ORDER) ---

# CJdropshipping MCP token (primary engine, src/extractors/cj_mcp_extractor.py).
# Generate it on CJ's API Authorization page; the client appends it to the
# remote MCP endpoint as a path segment (never logged).
CJ_MCP_TOKEN="YOUR_COPIED_MCP_TOKEN"
# Remote MCP endpoint WITHOUT the token (the token is appended at connect time)
#CJ_MCP_BASE_URL="https://developers.cjdropshipping.com/mcp"

# AliExpress Dropshipping Center ingestion
# (src/extractors/aliexpress_ds.py) — searches the DS Center itself, so the
# landed cost is the real AU-market dropshipping price. No credential needed.
# Optional saved login (Playwright storage_state) — the DS Center answers
# anonymously, so this is injected only when the file exists. Refresh with:
# python scripts/generate_ali_session.py
#ALI_DS_STATE_PATH="ali_ds_state.json"
# Catalogue-search page size per keyword (also the per-keyword expansion cap)
#ALI_DS_MAX_PRODUCTS="20"
# Winning-product gate: minimum historical orders and minimum rating out of 5.
# An item the DS Center reports no figure for fails the gate (unproven).
#MIN_DS_ORDER_COUNT="500"
#MIN_DS_RATING="4.5"

# --- Extractor chain & pricing ---

# Comma-separated supplier keys for auto mode (default: cjdropshipping,aliexpress)
#SUPPLIER_PRIORITY_ORDER="cjdropshipping,aliexpress"
# Supplier list prices are USD; extractors convert to AUD with this rate
#USD_TO_AUD="1.55"
# CJ commercial gate: minimum dropshipper listing count (`listedNum`). CJ
# reports no historical-sales figure on any tool, so the listing count is the
# only demand proof available; a listing that reports none fails the gate.
#MIN_CJ_LISTED_COUNT="150"
# CJ shipping method to cost against, by CJ's own name (e.g. "CJPacket Eub").
# Blank = the cheapest method the freight quote offers. A name the quote does
# not offer falls back to the cheapest.
#CJ_FREIGHT_METHOD="CJPacket Eub"
# Max CJ products expanded (product-detail fetch + gallery) per keyword
#CJ_MAX_PRODUCTS="10"

# Margin floor (deterministic half of evaluation gate 2): an ACCEPT must clear
# markup >= MIN_MARKUP_MULTIPLIER OR gross profit > MIN_MARGIN_AUD, against the
# real landed cost, or it is downgraded to REJECT.
#MIN_MARKUP_MULTIPLIER="2.5"
#MIN_MARGIN_AUD="20.0"

# Target country for supplier discovery: the AliExpress Dropshipping Center's
# ship-to market (it decides both the catalogue and the quoted price), and the
# CJ liveness gate's preferred stock country (CJ's own warehouse filter is
# pinned to CN)
#TARGET_COUNTRY="AU"

# --- LLM evaluation (Ollama Cloud, OpenAI-compatible) ---
LLM_BASE_URL="https://ollama.com/v1"
LLM_API_KEY="your_ollama_cloud_api_token"
LLM_MODEL="deepseek-v4-flash:cloud"

# --- Export destination (Shopify workspace) ---
#EXPORT_DIR="/Users/ahmadammari/PD/my-store-build/inspiration/dropship-candidates"

# --- Misc ---
# Desktop UA used by CDN downloads and the Playwright PDP gallery harvest
# (default: a desktop Chrome UA)
#USER_AGENT=""