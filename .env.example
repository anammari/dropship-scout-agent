# Dropship Scout Agent — configuration template.
# Copy to `.env` and fill in. A blank or commented key resolves to its code
# default in src/config.py; real environment variables always win over .env.

# ---------------------------------------------------------------- supplier ---
# CJdropshipping MCP token; the client appends it to the endpoint URL, never logs it.
CJ_MCP_TOKEN="YOUR_COPIED_MCP_TOKEN"
# MCP endpoint without the token (the token is appended at connect time).
#CJ_MCP_BASE_URL="https://developers.cjdropshipping.com/mcp"
# Comma-separated supplier keys for auto mode.
#SUPPLIER_PRIORITY_ORDER="cjdropshipping"
# Minimum `listedNum` for the CJ commercial gate — CJ's only demand signal.
#MIN_CJ_LISTED_COUNT="150"
# Pin a CJ shipping service by its own name; blank takes the cheapest quoted.
#CJ_FREIGHT_METHOD="CJPacket EUB"
# Product-detail expansions per CJ keyword.
#CJ_MAX_PRODUCTS="10"

# ------------------------------------------------------------ pricing/gates ---
# USD→AUD rate used for every `price_aud` and margin figure.
#USD_TO_AUD="1.55"
# Margin floor: ACCEPT needs markup ≥ this OR gross profit > MIN_MARGIN_AUD.
#MIN_MARKUP_MULTIPLIER="2.5"
#MIN_MARGIN_AUD="10.0"
# Discovery target country.
#TARGET_COUNTRY="AU"
# CJ freight destination lane; blank/absent means AU.
#CJ_DEFAULT_DEST_COUNTRY="AU"

# --------------------------------------------------------------------- LLM ---
# Ollama Cloud, OpenAI-compatible.
LLM_BASE_URL="https://ollama.com/v1"
# Ollama Cloud API token.
LLM_API_KEY="your_ollama_cloud_api_token"
# Evaluation model. ollama.com retires builds; check before pinning.
LLM_MODEL="deepseek-v4.1-flash"

# ----------------------------------------------------------------- HasData ---
# Used by the Step-2 Trends MCP header and the Step-3 Shopping REST source.
HASDATA_API_KEY="YOUR_HASDATA_API_KEY"
# Free-tier monthly ceiling.
#HASDATA_MONTHLY_BUDGET="1000"
# Hard credit cap one full production run may plan (Steps 2 + 3).
#HASDATA_PRODUCTION_CAP="400"
# Step-3 keyword-count cap: one request per keyword, so this IS the spend.
#HASDATA_GS_MAX_KEYWORDS="30"
# Step-2 Trends call cap (up to 5 comma-separated terms per call).
#TRENDS_MAX_CALLS="10"
# Rates the guardrail arithmetic uses. Trends is 10 credits per request.
#HASDATA_TRENDS_CREDITS_PER_CALL="10"
#HASDATA_SHOPPING_CREDITS_PER_REQUEST="10"
# Shopping REST base; the client appends /scrape/google/shopping.
#HASDATA_GS_BASE_URL="https://api.hasdata.com"
# Local cap on rows kept per keyword. Bounds LLM curation only, never spend.
#HASDATA_GS_MAX_RESULTS_PER_KEYWORD="20"
# Demand geography and retail-price benchmarks (AU-first launch).
#TRENDS_GEO="AU"
#SHOPPING_GL="au"
#SHOPPING_DOMAIN="google.com.au"

# ------------------------------------------------------- deliverable paths ---
# Step-2 deliverable: the gated trend keyword list feeding Step 3.
#MORNING_ANTHEM_TREND_KEYWORDS_PATH="outputs/json/morning-anthem-step-2-trend-keywords.json"
# Step-3 deliverable: the gold-standard product list; Steps 4 and 6 read it.
#MORNING_ANTHEM_GOLD_PRODUCTS_PATH="outputs/json/morning-anthem-step-3-gold-products.json"
# Step-4 deliverable: the supplier keyword bank Step 5 ingests.
#MORNING_ANTHEM_KEYWORD_BANK_PATH="outputs/json/morning-anthem-step-4-keyword-bank.json"
# Step-6 ranking report, which Step 7 reads.
#MORNING_ANTHEM_RANKED_CANDIDATES_PATH="outputs/json/morning-anthem-step-6-ranked-candidates.json"

# --------------------------------------------------------------- step 5/7 ---
# Packages exported per (product, engine) leg.
#BANK_TARGET_PER_PRODUCT="2"
# Exact dated ingestion batch root; product-NN packages are written directly here.
#MORNING_ANTHEM_EXPORT_DIR=""
# How many `review` packages Step 7 keeps; `disregard` is always deleted.
#CLEANUP_REVIEW_KEEP="10"
# Global ceiling on one product family; overrides the shortlist keep. 0 disables.
#CLEANUP_MAX_PER_FAMILY="5"
# Single-keyword ingestion destination; product-NN packages are written directly here.
#EXPORT_DIR="/Users/ahmadammari/PD/my-store-build/ingestion/single-keyword"
# User agent for CDN downloads.
#USER_AGENT=""

# ----------------------------------------------------------------- step 6 ---
# OpenRouter key for the System One decisions endpoint; never logged.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# OpenRouter API base; the client appends /systemone.
#OPENROUTER_BASE_URL=""
# Decision model for Step 6. Jev is the default; override per run with
# `--decision-model perplexity/pplx-decider-flash-v1.2` rather than editing this.
#JEV_MODEL="typesafe/jev-1.13"
# Send the supplier photo with the decision. The endpoint is text-only, so OFF.
#JEV_SEND_IMAGES="false"
# Gallery images inlined per package when JEV_SEND_IMAGES is on.
#JEV_IMAGES_PER_PACKAGE="1"
# Packages per System One call (three typed questions ride each).
#JEV_BATCH_SIZE="4"
# Tier floors on rank_score = 0.6*similarity + 0.4*value (1-5 scale).
#JEV_SHORTLIST_MIN_SCORE="3.5"
#JEV_REVIEW_MIN_SCORE="2.5"

# ------------------------------------------------------- step 2/3 gates ---
# Candidate trend strings per System One call in the Step-2 intent gate.
#TREND_GATE_BATCH_SIZE="8"
# Step-2 selection pass: candidates per call, and how many to select.
#TREND_SELECT_BATCH_SIZE="12"
#TREND_SELECT_TARGET="30"
# Per-pillar floor in the selection cut; 0 selects a pure best-of.
#TREND_SELECT_MIN_PER_PILLAR="2"
# Candidate products per System One call in the Step-3 pillar gate.
#PILLAR_GATE_BATCH_SIZE="4"
