# ---------------------------------------------------------------------------
# Dropship Scout Agent — runtime configuration template.
# Copy to `.env` and fill in the values you use. Every key here is read by
# src/config.py (Settings); real environment variables always win over .env.
# Full reference: CLAUDE.md §10 and README §1.5.
# ---------------------------------------------------------------------------

# --- Supplier extractors (tried in SUPPLIER_PRIORITY_ORDER) ---

# CJdropshipping MCP token (primary engine, src/extractors/cj_mcp_extractor.py).
# Generate it on CJ's API Authorization page; the client appends it to the
# remote MCP endpoint as a path segment (never logged).
CJ_MCP_TOKEN="YOUR_COPIED_MCP_TOKEN"
# Remote MCP endpoint WITHOUT the token (the token is appended at connect time)
#CJ_MCP_BASE_URL="https://developers.cjdropshipping.com/mcp"

# AliExpress Dropshipping Center ingestion
# (src/extractors/aliexpress_ds.py) — searches the DS Center itself, so the
# landed cost is the real AU-market dropshipping price. No credential needed.
# Optional saved login (Playwright storage_state) — the DS Center answers
# anonymously, so this is injected only when the file exists. Refresh with:
# python scripts/generate_ali_session.py
#ALI_DS_STATE_PATH="ali_ds_state.json"
# Catalogue-search page size per keyword (also the per-keyword expansion cap)
#ALI_DS_MAX_PRODUCTS="20"
# Winning-product gate: minimum historical orders and minimum rating out of 5.
# An item the DS Center reports no figure for fails the gate (unproven).
#MIN_DS_ORDER_COUNT="500"
#MIN_DS_RATING="4.5"

# --- Extractor chain & pricing ---

# Comma-separated supplier keys for auto mode (default: cjdropshipping,aliexpress)
#SUPPLIER_PRIORITY_ORDER="cjdropshipping,aliexpress"
# Supplier list prices are USD; extractors convert to AUD with this rate
#USD_TO_AUD="1.55"
# CJ commercial gate: minimum dropshipper listing count (`listedNum`). CJ
# reports no historical-sales figure on any tool, so the listing count is the
# only demand proof available; a listing that reports none fails the gate.
#MIN_CJ_LISTED_COUNT="150"
# CJ shipping method to cost against, by CJ's own name (e.g. "CJPacket Eub").
# Blank = the cheapest method the freight quote offers. A name the quote does
# not offer falls back to the cheapest.
#CJ_FREIGHT_METHOD="CJPacket Eub"
# Max CJ products expanded (product-detail fetch + gallery) per keyword
#CJ_MAX_PRODUCTS="10"

# Margin floor (deterministic half of evaluation gate 2): an ACCEPT must clear
# markup >= MIN_MARKUP_MULTIPLIER OR gross profit > MIN_MARGIN_AUD, against the
# real landed cost, or it is downgraded to REJECT. Defaults: 2.5 / 10.0
# (margin floor widened to AUD 10 with the operator's Step-3 $10 target on
# 2026-09-29).
#MIN_MARKUP_MULTIPLIER="2.5"
#MIN_MARGIN_AUD="10.0"

# Target country for supplier discovery: the AliExpress Dropshipping Center's
# ship-to market (it decides both the catalogue and the quoted price), and the
# CJ liveness gate's preferred stock country (CJ's own warehouse filter is
# pinned to CN)
#TARGET_COUNTRY="AU"

# --- LLM evaluation (Ollama Cloud, OpenAI-compatible) ---
LLM_BASE_URL="https://ollama.com/v1"
LLM_API_KEY="your_ollama_cloud_api_token"
LLM_MODEL="deepseek-v4-flash:cloud"

# --- Trend research (keyword brainstorming; MCP servers) ---
# Consumed by the project MCP config (.mcp.json + scripts/mcp_headers.py), not
# by src/config.py: they authenticate the Google Trends MCP servers the keyword
# stage queries during brainstorming. Both credentials are free-tier.

# HasData Google Trends MCP — the default trend source. Sent as the MCP
# server's `x-api-key` header. Free tier: 1,000 credits/month, and a Trends
# call costs 5 credits (200 calls); failed calls are not billed.
HASDATA_API_KEY="YOUR_HASDATA_API_KEY"
# Apify API token — shared by two actors on the same Apify account:
# (1) Step 2's FALLBACK trend source — data_xplorer/google-trends-fast-scraper,
#     driven via the Apify MCP (Bearer auth) and used ONLY when the primary
#     HasData Google Trends MCP is unavailable, rate-limited, or returns an
#     info-poor schema. It bills $2.00 per 1,000 results.
# (2) Step 3's CORE gold-research actor — damilo/google-shopping-apify
#     (apify-client auth; see the Step 3 block below), which bills $3.50 per
#     1,000 results.
# Apify's free plan includes $10 of credit; failed calls are not billed.
APIFY_TOKEN="YOUR_APIFY_API_TOKEN"

# --- Step 3 gold-standard research (Apify Google Shopping actor) ---
# Actor id for the gold-product scrape (default damilo/google-shopping-apify).
#APIFY_GS_ACTOR=""
# Results requested per keyword per run — the Apify spend ceiling (pay-per-result).
#APIFY_GS_MAX_RESULTS_PER_KEYWORD="10"
# Hard USD spend ceiling per run, enforced by Apify itself. Default 7.5: sized
# above the observed full-bank envelope (~$5.60 — the actor returns ~40 rows
# per keyword regardless of num) and within the free-tier remainder, so the
# production run is never aborted by its own safety net.
#APIFY_GS_MAX_CHARGE_USD="7.5"

# Step-3 gold product deliverable (untracked outputs/ tree — production
# deliverables of the updated pipeline live there).
#GOLD_PRODUCTS_PATH="outputs/json/step-3-gold-standard-products.json"

# --- Step 4 gold-standard keyword bank ---
# Step-4 deliverable — the Step-5 "keyword bank" (untracked outputs/ tree):
# the 50-70 supplier search keywords generated from the Step-3 gold products,
# which Step 5 ingests through BOTH supplier pipelines.
#KEYWORD_BANK_PATH="outputs/json/step-4-gold-keywords.json"

# --- Step 5 dual-supplier ingestion (CJ MCP + AliExpress DS Center) ---
# Packages to export per (keyword, engine) leg. It is a PER-LEG target, so the
# keyword count multiplies it; blank/absent means the code default (2).
#BANK_TARGET_PER_KEYWORD="2"
# Gold-kernel intake root: the runner writes each engine's packages into its
# own subfolder (cjdropshipping/product-NN, aliexpress/product-NN), numbered
# independently. Default: …/inspiration/optimal-dropship-candidates.
#OPTIMAL_EXPORT_DIR=""

# --- Export destination (Shopify workspace) ---
#EXPORT_DIR="/Users/ahmadammari/PD/my-store-build/inspiration/dropship-candidates"

# --- Misc ---
# Desktop UA used by CDN downloads and the Playwright PDP gallery harvest
# (default: a desktop Chrome UA)
#USER_AGENT=""

# --- Step 6: Jev product ranking (updated multi-step pipeline) ---
# OpenRouter API key for the System One endpoint (model typesafe/jev-1.13).
# Sent as a Bearer token; never logged. Get it from https://openrouter.ai/keys.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# OpenRouter API base; the client appends the /systemone path.
# Default: https://openrouter.ai/api/v1
#OPENROUTER_BASE_URL=""
# System One model id (OpenRouter form). Pinned on purpose: the
# `~typesafe/jev-latest` alias moves, while a pinned version keeps a ranking
# reproducible. Default: typesafe/jev-1.13
#JEV_MODEL=""
# Packages per System One call. Three typed questions ride each package, so 4
# matches the documented ~13-questions-per-call batch envelope; blank/absent
# means the code default (4).
#JEV_BATCH_SIZE="4"
# Tier floors on rank_score = 0.6*similarity + 0.4*value (1-5 scale):
# >= JEV_SHORTLIST_MIN_SCORE -> shortlist, >= JEV_REVIEW_MIN_SCORE -> review,
# else disregard. Jev's raw score is a 0-based level position and is shifted
# onto 1-5 before comparison. Defaults: 3.5 / 2.5 (shortlist floor widened
# from 4.0 with the operator's 2026-09-29 calibration).
#JEV_SHORTLIST_MIN_SCORE="3.5"
#JEV_REVIEW_MIN_SCORE="2.5"
