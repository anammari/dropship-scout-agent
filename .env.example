# ---------------------------------------------------------------------------
# Dropship Scout Agent — runtime configuration template.
# Copy to `.env` and fill in the values you use. Every key here is read by
# src/config.py (Settings); real environment variables always win over .env.
# Full reference: CLAUDE.md §10 and README §1.5.
# ---------------------------------------------------------------------------

# --- Supplier extractors (tried in SUPPLIER_PRIORITY_ORDER) ---

# CJdropshipping MCP token (the sole supplier engine,
# src/extractors/cj_mcp_extractor.py). Generate it on CJ's API Authorization
# page; the client appends it to the remote MCP endpoint as a path segment
# (never logged).
CJ_MCP_TOKEN="YOUR_COPIED_MCP_TOKEN"
# Remote MCP endpoint WITHOUT the token (the token is appended at connect time)
#CJ_MCP_BASE_URL="https://developers.cjdropshipping.com/mcp"

# --- Extractor chain & pricing ---

# Comma-separated supplier keys for auto mode (default: cjdropshipping)
#SUPPLIER_PRIORITY_ORDER="cjdropshipping"
# CJ quotes list prices and freight in USD; extractors convert to AUD with
# this rate so every price_aud / margin figure is a like-for-like AUD number
# (the store prices, carts and customer payments are strictly in AUD at launch).
#USD_TO_AUD="1.55"
# CJ commercial gate: minimum dropshipper listing count (`listedNum`). CJ
# reports no historical-sales figure on any tool, so the listing count is the
# only demand proof available; a listing that reports none fails the gate.
#MIN_CJ_LISTED_COUNT="150"
# CJ shipping method to cost against, by CJ's own name (e.g. "CJPacket EUB").
# Blank = the cheapest method the freight quote offers. A name the quote does
# not offer falls back to the cheapest.
#CJ_FREIGHT_METHOD="CJPacket EUB"
# Max CJ products expanded (product-detail fetch + gallery) per keyword
#CJ_MAX_PRODUCTS="10"

# Margin floor (deterministic half of evaluation gate 2): an ACCEPT must clear
# markup >= MIN_MARKUP_MULTIPLIER OR gross profit > MIN_MARGIN_AUD, against
# the real landed cost in AUD, or it is downgraded to REJECT. Defaults:
# 2.5 / 10.0 (AUD 10.00 = the operator's target gross margin per unit,
# supporting the >= 20% margin threshold at launch).
#MIN_MARKUP_MULTIPLIER="2.5"
#MIN_MARGIN_AUD="10.0"

# Target country for supplier discovery: the CJ freight quote's destination
# and the liveness gate's preferred stock country (CJ's own warehouse filter
# is pinned to CN). Australia-first launch; re-point on global expansion.
#TARGET_COUNTRY="AU"
# The CJ freight quote's destination lane: all launch products ship from CJ's
# China warehouse directly into Australia, so the quote must name an
# Australian delivery lane (e.g. CJPacket EUB). Blank/absent means AU.
#CJ_DEFAULT_DEST_COUNTRY="AU"

# --- LLM evaluation (Ollama Cloud, OpenAI-compatible) ---
LLM_BASE_URL="https://ollama.com/v1"
LLM_API_KEY="your_ollama_cloud_api_token"
LLM_MODEL="deepseek-v4-flash:cloud"

# --- Trend research & gold-product scrape (HasData — the exclusive provider) ---
# The Google Trends MCP server is authenticated by the project MCP config
# (.mcp.json + scripts/mcp_headers.py). The HasData API key is used by TWO
# things, on one shared credit balance:
# (1) Step 2's Google Trends MCP server, sent as its `x-api-key` header, via
#     scripts/mcp_headers.py (NOT read by src/config.py).
# (2) Step 3's HasData Google Shopping source
#     (src/extractors/google_shopping_hasdata.py), which src/config.py reads
#     to call the REST API directly — the pipeline's ONLY shopping source
#     (the Apify actor was retired on the Morning Anthem branch).
# Free tier: 1,000 credits/month; a Trends call costs 5 credits and a Google
# Shopping call costs 10 (one request returns the whole grid for a query).
# Failed calls are not billed.
HASDATA_API_KEY="YOUR_HASDATA_API_KEY"

# --- HasData budget guardrails (credits/month) ---
# Free-tier monthly ceiling and the hard cap one full production run may
# consume across Steps 2-3 (Step 2 Trends: <= 10 calls x 5 = 50 credits;
# Step 3 Shopping: <= 20 keywords x 10 = 200 credits; total 250).
#HASDATA_MONTHLY_BUDGET="1000"
#HASDATA_PRODUCTION_CAP="250"
# Step-3 hard keyword-count cap: one request per keyword = 10 credits, so the
# request count IS the spend; the runner refuses to start above this count.
#HASDATA_GS_MAX_KEYWORDS="20"
# Step-2 Trends research hard cap (calls, 5 credits each).
#TRENDS_MAX_CALLS="10"

# --- Step 3 gold-standard research (Google Shopping AU, HasData only) ---
# HasData REST base; the client appends /scrape/google/shopping.
#HASDATA_GS_BASE_URL="https://api.hasdata.com"
# LOCAL cap on rows kept per keyword. NOT an API parameter: one request
# returns the whole shopping grid for a query (~65 rows observed 2026-10-07)
# and costs 10 credits whatever the slice, so this bounds LLM curation cost
# only, never HasData spend.
#HASDATA_GS_MAX_RESULTS_PER_KEYWORD="20"
# Demand geography. Australia-first launch: demand signals and price
# benchmarks reflect Australian shopper behaviour and AUD retail pricing.
#TRENDS_GEO="AU"
#SHOPPING_GL="au"
#SHOPPING_DOMAIN="google.com.au"

# Step-2 deliverable: the Jev-gated trend keyword list feeding Step 3
# (untracked outputs/ tree — production deliverables of the Morning Anthem
# pipeline live there).
#MORNING_ANTHEM_TREND_KEYWORDS_PATH="outputs/json/morning-anthem-step-2-trend-keywords.json"
# Step-3 deliverable: the gold-standard product list (untracked outputs/
# tree); Steps 4 and 6 read the gold product list from here.
#MORNING_ANTHEM_GOLD_PRODUCTS_PATH="outputs/json/morning-anthem-step-3-gold-products.json"

# --- Step 4 gold-standard keyword bank ---
# Step-4 deliverable — the Step-5 "keyword bank" (untracked outputs/ tree):
# the supplier search keywords generated from the Step-3 gold products, which
# Step 5 ingests through the CJdropshipping MCP pipeline.
#MORNING_ANTHEM_KEYWORD_BANK_PATH="outputs/json/morning-anthem-step-4-keyword-bank.json"

# --- Step 5 CJ-only ingestion ---
# Packages to export per (keyword, engine) leg. It is a PER-LEG target, so the
# keyword count multiplies it; blank/absent means the code default (2).
#BANK_TARGET_PER_KEYWORD="2"
# Morning Anthem gold-kernel intake root: the runner writes the supplier's
# packages into its subfolder (cjdropshipping/product-NN), numbered
# independently. Default: …/inspiration/morning-anthem-candidates.
#MORNING_ANTHEM_EXPORT_DIR=""

# --- Export destination (Shopify workspace) ---
#EXPORT_DIR="/Users/ahmadammari/PD/my-store-build/inspiration/dropship-candidates"

# --- Misc ---
# Desktop UA used by CDN downloads (default: a desktop Chrome UA)
#USER_AGENT=""

# --- Step 6: Jev product ranking (Morning Anthem pipeline) ---
# OpenRouter API key for the System One endpoint (model typesafe/jev-1.13).
# Also used by the Step-2 product-intent gate and the Step-3 pillar gate.
# Sent as a Bearer token; never logged. Get it from https://openrouter.ai/keys.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# OpenRouter API base; the client appends the /systemone path.
# Default: https://openrouter.ai/api/v1
#OPENROUTER_BASE_URL=""
# System One model id (OpenRouter form). Pinned on purpose: the
# `~typesafe/jev-latest` alias moves, while a pinned version keeps a ranking
# reproducible. Default: typesafe/jev-1.13
#JEV_MODEL=""
# Packages per System One call. Three typed questions ride each package, so 4
# matches the documented ~13-questions-per-call batch envelope; blank/absent
# means the code default (4).
#JEV_BATCH_SIZE="4"
# Tier floors on rank_score = 0.6*similarity + 0.4*value (1-5 scale):
# >= JEV_SHORTLIST_MIN_SCORE -> shortlist, >= JEV_REVIEW_MIN_SCORE -> review,
# else disregard. Jev's raw score is a 0-based level position and is shifted
# onto 1-5 before comparison. Defaults: 3.5 / 2.5 (shortlist floor widened
# from 4.0 with the operator's 2026-09-29 calibration).
#JEV_SHORTLIST_MIN_SCORE="3.5"
#JEV_REVIEW_MIN_SCORE="2.5"

# --- Step 2 & Step 3 Jev gates (Morning Anthem pipeline) ---
# Candidate trend strings per System One call in the Step-2 product-intent
# gate (default: 8).
#TREND_GATE_BATCH_SIZE="8"
# Candidate products per System One call in the Step-3 pillar gate
# (default: 4).
#PILLAR_GATE_BATCH_SIZE="4"
